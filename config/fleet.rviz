Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Plane Cell Count: 20
    Cell Size: 1.0
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Marker Scale: 3.0
  - Class: rviz_default_plugins/RobotModel
    Name: tb1 model
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb1/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    TF Prefix: tb1
  - Class: rviz_default_plugins/Odometry
    Name: tb1 odom
    Enabled: true
    Topic:
      Value: /tb1/odom
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Keep: 200
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Shape:
      Value: Arrow
      Color: 229; 127; 0
      Shaft Length: 0.15
      Shaft Radius: 0.01
      Head Length: 0.05
      Head Radius: 0.02
      Alpha: 1.0
    Covariance:
      Value: false
  - Class: rviz_default_plugins/RobotModel
    Name: tb2 model
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb2/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    TF Prefix: tb2
  - Class: rviz_default_plugins/Odometry
    Name: tb2 odom
    Enabled: true
    Topic:
      Value: /tb2/odom
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 5
    Keep: 200
    Position Tolerance: 0.05
    Angle Tolerance: 0.1
    Shape:
      Value: Arrow
      Color: 0; 102; 229
      Shaft Length: 0.15
      Shaft Radius: 0.01
      Head Length: 0.05
      Head Radius: 0.02
      Alpha: 1.0
    Covariance:
      Value: false
  - Class: rviz_default_plugins/RobotModel
    Name: tb3 model
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /tb3/robot_description
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Depth: 1
    TF Prefix: tb3
  - Class: rviz_default_plugins/Odometry
    Name: tb3 odom
    Enabled: true
